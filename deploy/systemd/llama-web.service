[Unit]
Description=llama-web authenticated workspace
Wants=llama-web-engine.service
After=llama-web-engine.service

[Service]
WorkingDirectory=%h/.local/share/llama-web
ExecStart=%h/.local/share/llama-web/.venv/bin/python %h/.local/share/llama-web/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
